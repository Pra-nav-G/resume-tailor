# .env.example: commit this file; never commit .env.
# Copy it to .env and fill in real values locally:  cp .env.example .env

# SQLite database file (ADR 0006). Holds personal data; keep it out of git (data/ is gitignored).
DATABASE_PATH=data/resume-tailor.db

# Encrypts AI provider keys saved in Settings (ADR 0002), used from S-03. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes saved keys unreadable; re-enter them after rotating.
KEY_ENCRYPTION_SECRET=replace-me

# AI provider keys are NOT set here; they're entered in the app's Settings and stored encrypted.
# Sign-in variables arrive with S-02 (Phone access milestone).
