# .env.example: commit this file; never commit .env.
# Copy it to .env and fill in real values locally:  cp .env.example .env

# Postgres connection (ADR 0001)
DATABASE_URL=postgres://user:password@localhost:5432/resume_tailor_dev

# Auth (ADR 0005): GitHub OAuth app + the one GitHub login allowed in
AUTH_SECRET=replace-me-with-a-long-random-string
AUTH_GITHUB_ID=replace-me
AUTH_GITHUB_SECRET=replace-me
ALLOWED_GITHUB_LOGIN=your-github-username

# Encrypts AI provider keys saved in Settings (ADR 0002). 32 random bytes, base64.
# Changing it makes saved keys unreadable; re-enter them after rotating.
KEY_ENCRYPTION_SECRET=replace-me

# Background runner (ADR 0003), only if Inngest is chosen
# INNGEST_EVENT_KEY=replace-me
# INNGEST_SIGNING_KEY=replace-me

# AI provider keys are NOT set here; they're entered in the app's Settings and stored encrypted.
